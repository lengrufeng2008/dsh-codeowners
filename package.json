{
  "name": "dsh-codeowners",
  "version": "0.1.0",
  "description": "Read-only CODEOWNERS matching for DSH with GitHub-style last-match-wins patterns.",
  "type": "module",
  "bin": { "dsh-codeowners": "bin/dsh-codeowners.mjs" },
  "exports": { ".": "./plugin/index.js", "./codeowners": "./src/codeowners.mjs", "./plugin": "./plugin/index.js", "./icon": "./icon.svg" },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "codeowners", "git", "review", "routing"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-codeowners" }
}
